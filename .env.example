# Серверийн тохиргоо
PORT=3000
# Локал дээр: development.  Сервер дээр HTTPS-тэй бол: production (secure cookie идэвхжинэ)
NODE_ENV=development

# Аюулгүй байдлын түлхүүр (заавал өөрчилнө үү! урт, санамсаргүй тэмдэгт)
JWT_SECRET=solих-урт-нууц-тулхуур-энийг-заавал-солино-uu

# Анхны админ хэрэглэгч (эхний ажиллуулахад автоматаар үүснэ)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin12345
ADMIN_NAME=Админ

# Нийгмийн сүлжээний холбоос (нүүр хуудсанд харагдана)
FACEBOOK_URL=https://facebook.com/yourpage
TELEGRAM_URL=https://t.me/yourchannel

# Сайтын нэр (лого дээр "VIP" автоматаар нэмэгдэнэ, ж: Movie -> MovieVIP)
SITE_NAME=Movie
